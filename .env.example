# ============================================================
# FreshBeat — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# ============================================================

# --- Telegram ---
BOT_TOKEN=
# Username público do bot (sem @), usado em deep-links
BOT_USERNAME=

# --- Banco de dados (Postgres) ---
# Local (docker compose): postgres://freshbeat:freshbeat@localhost:5432/freshbeat
DATABASE_URL=

# --- Cache / estado temporário (Redis) ---
# Local (docker compose): redis://localhost:6379
REDIS_URL=

# --- Last.fm ---
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Spotify (client credentials) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Genius (fallback de letras — opcional) ---
GENIUS_ACCESS_TOKEN=

# --- OpenRouter (IA: explicação, tradução, descrição de imagem) ---
OPENROUTER_API_KEY=
# Modelos configuráveis (veja https://openrouter.ai/models)
AI_MODEL_EXPLAIN=
AI_MODEL_TRANSLATE=
AI_MODEL_IMAGE_PROMPT=

# --- Replicate (geração de imagem) ---
REPLICATE_API_TOKEN=

# --- Storage S3-compatível (imagens geradas) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- Site (Next.js) ---
# URL pública do site, ex.: https://freshbeat.vercel.app (local: http://localhost:3000)
WEB_BASE_URL=
# Segredo para assinar estados de OAuth/sessão do dashboard
WEB_SESSION_SECRET=

# --- Observabilidade ---
# Nível de log: trace | debug | info | warn | error (padrão: info)
LOG_LEVEL=info
