# ============================================================
# FreshBeat — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# ============================================================

# --- Telegram ---
BOT_TOKEN=
# Username público do bot (sem @), usado em deep-links
BOT_USERNAME=

# --- Banco de dados (Postgres) ---
# Local (docker compose): postgres://freshbeat:freshbeat@localhost:5432/freshbeat
DATABASE_URL=

# --- Cache / estado temporário (Redis) ---
# Local (docker compose): redis://localhost:6379
REDIS_URL=

# --- Last.fm ---
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Spotify (client credentials) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OpenRouter (IA: explicação, tradução, descrição de imagem) ---
OPENROUTER_API_KEY=
# Modelos (veja https://openrouter.ai/models).
# OPCIONAIS — o padrão de todos é minimax/minimax-m3.
#AI_MODEL_EXPLAIN=minimax/minimax-m3
#AI_MODEL_TRANSLATE=minimax/minimax-m3
#AI_MODEL_IMAGE_PROMPT=minimax/minimax-m3
#AI_MODEL_ALT_TEXT=minimax/minimax-m3

# --- Replicate (geração de imagem) ---
REPLICATE_API_TOKEN=
# OPCIONAL — o padrão é prunaai/p-image
#REPLICATE_IMAGE_MODEL=prunaai/p-image

# --- Storage S3-compatível (imagens geradas) ---
# O compose já sobe um MinIO: NADA aqui é obrigatório para rodar via
# docker compose — os defaults internos apontam para ele. Preencha só
# se for usar outro provider S3 ou se o bot roda FORA do compose.
# Bot local (npm run dev) + MinIO do compose:
#   S3_ENDPOINT=http://localhost:9000
#   S3_ACCESS_KEY / S3_SECRET_KEY = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# S3_PUBLIC_URL precisa ser alcançável pela internet em produção
# (o Telegram baixa a imagem por ela), ex.: https://s3.seudominio.com/freshbeat
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- MinIO (storage local do compose) ---
# Credenciais do MinIO que o compose sobe. TROQUE em produção/Coolify!
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Site (Next.js) ---
# URL pública do site, ex.: https://freshbeat.vercel.app (local: http://localhost:3000)
WEB_BASE_URL=
# Segredo para assinar estados de OAuth/sessão do dashboard
WEB_SESSION_SECRET=
# Username do bot no Telegram (link t.me da landing)
NEXT_PUBLIC_BOT_USERNAME=
# URL do repositório (link da landing)
NEXT_PUBLIC_GITHUB_URL=

# --- Observabilidade ---
# Nível de log: trace | debug | info | warn | error (padrão: info)
LOG_LEVEL=info
